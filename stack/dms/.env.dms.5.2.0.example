# OneRoster service on Ed-Fi API v8 (DMS), DS 5.2, PostgreSQL, single tenant.
# Copy to .env.dms (git-ignored) and replace every <...> value.
PLATFORM=dms
PORT=3000
DB_TYPE=postgres
MAX_PAGE_SIZE=500
LOG_LEVEL=info
MULTITENANCY_ENABLED=false

# Tokens: issued by the Configuration Service (self-contained provider). The issuer is the
# exact iss claim; the JWKS URL uses the CMS network alias because the issuer host
# (ed-fi-api-config) only resolves inside the DMS container.
OAUTH2_TOKEN_PROFILE=cms-self-contained
OAUTH2_ISSUER=http://ed-fi-api-config:8081
OAUTH2_AUDIENCE=account
OAUTH2_JWKS_URL=http://config:8081/.well-known/jwks.json
OAUTH2_TOKEN_URL=http://localhost:8080/oauth/token

# DMS claim set -> OneRoster scopes. Claim sets for OneRoster should grant no Ed-Fi resources.
ONEROSTER_CLAIMSET_SCOPES={"OneRoster-ReadOnly":["roster.readonly","roster-demographics.readonly"],"OneRoster-Core":["roster-core.readonly"]}

# Data stores from the Configuration Service (read-only client)
CONFIG_SERVICE_URL=http://config:8081
CONFIG_SERVICE_CLIENT_ID=CMSAuthMetadataReadOnlyAccess
CONFIG_SERVICE_CLIENT_SECRET=<CMS read-only client secret>
CONFIG_SERVICE_ENCRYPTION_KEY=<CONFIGURATION_SERVICE_DATABASE_ENCRYPTION_KEY from the DMS stack>

# pg-boss queue in its own database on the data-store server (created by deploy-dms.js --jobs-database)
PG_BOSS_CONNECTION_CONFIG={"adminConnection":"host=dms-postgresql;port=5432;username=postgres;password=<password>;database=oneroster_jobs"}
PGBOSS_CRON=*/15 * * * *

# Update the database username and password values before deployment.
# Use environment-appropriate credentials and avoid default credentials.

# OneRoster API port to serve on:
PORT=3000

# Optional base path when hosted behind IIS virtual directory (for deterministic discovery URLs)
# Example: /oneroster
API_BASE_PATH=

# Optional: maximum number of records a single collection request may return.
# Requests with a larger 'limit' are clamped to this value rather than rejected.
# Must be a positive integer (plain digits). Defaults to 500 when unset.
# There is no upper bound, but values above 10000 log a warning at startup: large pages
# increase memory use and response size and may exceed DB_REQUEST_TIMEOUT.
# The default page size (used when a request omits 'limit') is 100 and is not configurable.
MAX_PAGE_SIZE=500

# Database type: 'postgres' or 'mssql'
DB_TYPE=postgres

# Optional: the Ed-Fi platform to serve from. 'ods' (the default) is the Ed-Fi ODS/API 7.x;
# 'dms' is Ed-Fi API v8 (the Data Management Service, PostgreSQL and Data Standard 5.2 so far).
# 'dms' replaces the OAUTH2_ISSUERBASEURL/PEM and EdFi_Admin settings with the block under
# "Ed-Fi API v8 (DMS)" below. Local DMS stack: stack/dms/README.md.
# PLATFORM=ods

# Optional: per-query database timeout in milliseconds, applied on both engines
# (MSSQL requestTimeout, PostgreSQL statement_timeout). Raise it for large datasets
# or slower infrastructure; 0 disables the timeout. Defaults to 30000 when unset.
# DB_REQUEST_TIMEOUT=30000

# Optional: load ODS encryption key + JWT public PEM from a plugin instead of the two variables below.
# With PLATFORM=dms the plugin supplies the Configuration Service client secret, the connection-string
# encryption key and/or static DATA_STORES instead.
# Set APP_SECRETS_MODULE to enable (see docs/app-secrets-plugin.md).
# Example file-based plugin (reference only); APP_SECRETS_FILE is read by this plugin, not core:
# APP_SECRETS_MODULE=./src/config/examples/app-secrets-file.js
# APP_SECRETS_FILE=/secure/path/app-secrets.json

# Encryption key for ODS connection strings stored in EdFi_Admin.OdsInstances
# Generate with: openssl rand -base64 32
# Value must match the ODS API ApiSettings:OdsConnectionStringEncryptionKey configuration value.
# Required when ODS connection strings are stored in the EdFi_Admin.OdsInstances table.
# Not required when all ODS connection strings are provided via ODS_INSTANCES (single-tenant)
# or OdsInstances in TENANTS_CONNECTION_CONFIG (multi-tenant), typically when injecting
# plain-text connection strings from a cloud secret store.
ODS_CONNECTION_STRING_ENCRYPTION_KEY=

# SINGLE-TENANT MODE (Default EdFi_Admin Connection)
# For PostgreSQL (example):
# CONNECTION_CONFIG={"adminConnection":"host=localhost;port=5432;database=EdFi_Admin;username=postgres;password=<your_db_password>"}
# For MSSQL (example):
CONNECTION_CONFIG={"adminConnection":"server=localhost;database=EdFi_Admin;user id=sa;password=<your_db_password>;encrypt=false;TrustServerCertificate=true"}

# Optional: ODS instance connection strings (single-tenant mode).
# When set, ODS connections are resolved from here instead of querying EdFi_Admin.OdsInstances.
# Each instance requires ConnectionString. Add ContextValueByKey only when using ODS_CONTEXT_ROUTE_TEMPLATE.
# Connection strings can be plain text or encrypted (detected automatically).
# Example: ODS_INSTANCES={"3":{"ConnectionString":"Server=localhost;Database=EdFi_Ods_2026;user id=sa;password=<pwd>;encrypt=false","ContextValueByKey":{"schoolYearFromRoute":"2026"}},"4":{"ConnectionString":"Server=localhost;Database=EdFi_Ods_2027;user id=sa;password=<pwd>;encrypt=false"}}
# Leave empty to resolve ODS connections from the EdFi_Admin database (default).
ODS_INSTANCES=

# Node environment. No application behavior depends on this; Express treats
# any value other than 'production' as development.
NODE_ENV=dev

# Logger verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# pg-boss settings (PostgreSQL only):
# Explicit PostgreSQL admin connection used for pg-boss metadata storage.
# Valid options:
# - Tenant admin DB (multi-tenant mode)
# - Same admin DB referenced by CONNECTION_CONFIG (single-tenant mode)
# - Dedicated pg-boss database
# Example:
# PG_BOSS_CONNECTION_CONFIG={"adminConnection":"host=localhost;port=5432;database=EdFi_Admin;username=postgres;password=<your_db_password>"}
PG_BOSS_CONNECTION_CONFIG=
PGBOSS_CRON=*/15 * * * *

# OAuth2 settings - these must be filled out!
OAUTH2_ISSUERBASEURL=https://dev-5n8uf6ov.us.auth0.com/
OAUTH2_AUDIENCE=http://localhost:3000
OAUTH2_TOKENSIGNINGALG=RS256

# PEM-encoded public key for verifying JWTs.
# This is only a placeholder. Replace with your full multi-line PEM public key,
# encoded on a single line using '\n' between lines, including the END marker.
# Value must match the Security:Jwt:SigningKey:PublicKey configuration value in the ODS API appsettings.json.
# Example:
# OAUTH2_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----
OAUTH2_PUBLIC_KEY_PEM=

# Comma-separated list of allowed CORS origins
# Example: http://localhost:3000,http://localhost:56641/ (ODS API Swagger UI)
CORS_ORIGINS=http://localhost:3000

# Rate limiting settings
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# trust proxy tells your Node/Express app that it is running behind a reverse proxy (like IIS/ARR/nginx) and should trust forwarded headers.
TRUST_PROXY=false

# Multi-tenancy settings
MULTITENANCY_ENABLED=false

# Tenant list: use TENANTS_CONNECTION_CONFIG JSON, or set TENANTS_CONFIG_MODULE for a plugin (see docs/tenants-config-plugin.md).
# Example file-based plugin (reference only); TENANTS_CONFIG_FILE is read by this plugin, not core:
# TENANTS_CONFIG_MODULE=./src/config/examples/tenants-config-file.js
# TENANTS_CONFIG_FILE=/secure/path/tenants.json

# Reload tenant list without restart when TENANTS_CONFIG_MODULE is set: kill -USR2 <pid> (Linux)

# PostgreSQL example:
# TENANTS_CONNECTION_CONFIG={"Tenant1":{"adminConnection":"host=localhost;port=5432;database=EdFi_Admin_Tenant1;username=postgres;password=<tenant1_db_password>"},"Tenant2":{"adminConnection":"host=localhost;port=5432;database=EdFi_Admin_Tenant2;username=postgres;password=<tenant2_db_password>"}}
#
# MSSQL example:
# TENANTS_CONNECTION_CONFIG={"Tenant1":{"adminConnection":"server=localhost;database=EdFi_Admin_Tenant1;user id=sa;password=<tenant1_db_password>;encrypt=false"},"Tenant2":{"adminConnection":"server=localhost;database=EdFi_Admin_Tenant2;user id=sa;password=<tenant2_db_password>;encrypt=false"}}
#
# Optional: each tenant can include OdsInstances to define ODS connections directly instead of querying its EdFi_Admin database.
# ContextValueByKey is optional per instance — only needed when ODS_CONTEXT_ROUTE_TEMPLATE is configured.
#
# MSSQL example with OdsInstances and context routing:
# TENANTS_CONNECTION_CONFIG={"Tenant1":{"adminConnection":"server=localhost;database=EdFi_Admin_Tenant1;user id=sa;password=<tenant1_db_password>;encrypt=false","OdsInstances":{"3":{"ConnectionString":"Server=localhost;Database=EdFi_Ods_Tenant1_2026;user id=sa;password=<ods_password>;encrypt=false","ContextValueByKey":{"schoolYearFromRoute":"2026"}},"4":{"ConnectionString":"Server=localhost;Database=EdFi_Ods_Tenant1_2027;user id=sa;password=<ods_password>;encrypt=false","ContextValueByKey":{"schoolYearFromRoute":"2027"}}}},"Tenant2":{"adminConnection":"server=localhost;database=EdFi_Admin_Tenant2;user id=sa;password=<tenant2_db_password>;encrypt=false"}}
# Tenants without OdsInstances fall back to database-based ODS instance resolution.
TENANTS_CONNECTION_CONFIG=

# Ods context route template (PLATFORM=ods only)
# Examples:
#   ODS_CONTEXT_ROUTE_TEMPLATE={schoolYearFromRoute:range(2026,2027)}
# Leave empty to disable context routing
ODS_CONTEXT_ROUTE_TEMPLATE=

# Route qualifier segments (PLATFORM=dms only): comma-separated names, in order, matching the
# DMS AppSettings__RouteQualifierSegments setting, e.g. districtId,schoolYear.
# Leave empty to disable context routing
# ROUTE_QUALIFIER_SEGMENTS=

# --- Ed-Fi API v8 (DMS): PLATFORM=dms only ---------------------------------------------------
# Tokens come from the DMS Configuration Service (CMS) or Keycloak; OAUTH2_ISSUERBASEURL,
# OAUTH2_TOKENSIGNINGALG and OAUTH2_PUBLIC_KEY_PEM are not used. OAUTH2_AUDIENCE still is.
# Token profile: cms-self-contained (default; CMS self-contained identity provider) or standard
# (any OIDC issuer, such as Keycloak).
# OAUTH2_TOKEN_PROFILE=cms-self-contained
# The exact iss claim of DMS tokens, e.g. http://ed-fi-api-config:8081 on the local DMS stack.
# OAUTH2_ISSUER=
# Where the signing keys are: the JWKS URL, or the OIDC metadata URL that names it (one is required).
# OAUTH2_JWKS_URL=
# OAUTH2_METADATA_URL=
# Token endpoint advertised to clients (Swagger, /oauth/token redirect), e.g. the DMS /oauth/token.
# OAUTH2_TOKEN_URL=
# OAUTH2_CLOCK_SKEW_SECONDS=60
#
# DMS tokens carry the client's claim-set name as scope. Map claim sets to OneRoster scopes
# (short names expand to https://purl.imsglobal.org/spec/or/v1p2/scope/<name>). Required.
# A claim set that isn't listed gets 403. Give these claim sets no Ed-Fi resource grants.
# ONEROSTER_CLAIMSET_SCOPES={"OneRoster-ReadOnly":["roster.readonly","roster-demographics.readonly"],"OneRoster-Core":["roster-core.readonly"]}
#
# Data stores and their connection strings come from the Configuration Service, read with a
# read-only client (scope edfi_admin_api/authMetadata_readonly_access by default; multi-tenant
# deployments need a scope that can also read /v3/tenants). The encryption key is the CMS
# ConnectionStringEncryption key (CONFIGURATION_SERVICE_DATABASE_ENCRYPTION_KEY in the DMS stack).
# CONFIG_SERVICE_URL=
# CONFIG_SERVICE_CLIENT_ID=
# CONFIG_SERVICE_CLIENT_SECRET=
# CONFIG_SERVICE_SCOPE=
# CONFIG_SERVICE_ENCRYPTION_KEY=
# Also accept connection strings in the older AES-256-CBC format (default true; the current
# format is the AES-256-GCM envelope).
# CONFIG_SERVICE_ALLOW_LEGACY_CONNECTION_STRINGS=true
# Seconds to cache the data-store list (default 600, as in DMS). A miss reloads it once.
# DATA_STORE_CACHE_SECONDS=600
# Query a data store's ReadReplica derivative when it has one (default false).
# USE_READ_REPLICA=false
# Timeout in milliseconds for each request to the Configuration Service and for the OIDC metadata
# and JWKS requests (default 10000). A data-store lookup that times out answers 503.
# DMS_HTTP_TIMEOUT_MS=10000
# Startup warns when CONFIG_SERVICE_URL, OAUTH2_JWKS_URL or OAUTH2_METADATA_URL uses http to a host
# other than localhost: the client secret, connection strings or signing keys would cross the network
# in clear. Fine on a private Docker network; use https elsewhere.
#
# Refresh on PostgreSQL: deploy-dms.js adds change tracking, so a scheduled refresh skips a view
# whose sources haven't changed since its last refresh (PGBOSS_CRON still sets how often it checks).
#
# Single tenant, without the Configuration Service: data stores keyed by id. Plain connection
# strings need no encryption key; encrypted ones need CONFIG_SERVICE_ENCRYPTION_KEY.
# DATA_STORES={"1":{"ConnectionString":"host=localhost;port=5432;database=edfi_datamanagementservice;username=<user>;password=<password>","ContextValueByKey":{"schoolYear":"2026"}}}

# Optional HTTPS/TLS for the OneRoster API process
# When ENABLE_HTTPS=true, TLS_KEY_PATH and TLS_CERT_PATH are required.
ENABLE_HTTPS=false
TLS_KEY_PATH=
TLS_CERT_PATH=
# Optional CA bundle path for client certificate chain validation
TLS_CA_PATH=

# Docker healthcheck command used by the stack compose files.
# Set this to an HTTP URL when ENABLE_HTTPS=false.
# Example: ONEROSTER_API_HEALTHCHECK_TEST=["CMD","curl","-f","http://localhost:3000/health-check"]
# Set this to an HTTPS URL when ENABLE_HTTPS=true.
# Example: ONEROSTER_API_HEALTHCHECK_TEST=["CMD","curl","-f","https://localhost:3000/health-check","--insecure"]
ONEROSTER_API_HEALTHCHECK_TEST=["CMD","curl","-f","http://localhost:3000/health-check"]

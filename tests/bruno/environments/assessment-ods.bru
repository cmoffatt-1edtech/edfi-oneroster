vars {
  oauthScope: https://purl.imsglobal.org/spec/or/v1p2/scope/roster.readonly
  leaClientId: {{process.env.LEA_KEY}}
  leaClientSecret: {{process.env.LEA_SECRET}}
  schoolClientId: {{process.env.SCHOOL_KEY}}
  schoolClientSecret: {{process.env.SCHOOL_SECRET}}
  registrationSchoolClientId: {{process.env.ASSESSMENT_SCHOOL_KEY}}
  registrationSchoolClientSecret: {{process.env.ASSESSMENT_SCHOOL_SECRET}}
  coreClientId: {{process.env.LEA_KEY}}
  coreClientSecret: {{process.env.LEA_SECRET}}
  coreScope: https://purl.imsglobal.org/spec/or/v1p2/scope/roster-core.readonly
  noRosterClientId: {{process.env.LEA_KEY}}
  noRosterClientSecret: {{process.env.LEA_SECRET}}
  noRosterScope: https://purl.imsglobal.org/spec/or/v1p2/scope/roster-demographics.readonly
  oauthUrl: {{process.env.BASE_URL}}/{{process.env.ODS_API_VIRTUAL_NAME}}/oauth/token
  oneRosterUrl: {{process.env.BASE_URL}}/{{process.env.ONEROSTER_API_VIRTUAL_NAME}}
  assessmentPath: ims/oneroster/assessmentRostering/v1p0
}

meta {
  name: Other School Sees No Enrollments
  type: http
  seq: 27
}

get {
  url: {{oneRosterUrl}}/{{assessmentPath}}/assessmentEnrollments?limit=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ar-school-token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("0 assessmentEnrollments", function() {
    expect(res.getBody().assessmentEnrollments).to.have.lengthOf(0);
  });
}

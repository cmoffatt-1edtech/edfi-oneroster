meta {
  name: Get Lea Token
  type: http
  seq: 1
}

post {
  url: {{oauthUrl}}
  body: json
  auth: none
}

body:json {
  {
    "grant_type": "client_credentials",
    "client_id": "{{leaClientId}}",
    "client_secret": "{{leaClientSecret}}",
    "scope": "{{oauthScope}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('ar-lea-token', res.getBody().access_token);
  }
}

tests {
  test("token issued", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

meta {
  name: Registration School Lists Assessments
  type: http
  seq: 22
}

get {
  url: {{oneRosterUrl}}/{{assessmentPath}}/assessments?limit=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ar-registration-school-token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("24 assessments", function() {
    expect(res.getBody().assessments).to.have.lengthOf(24);
  });
}

meta {
  name: Pagination Last Page
  type: http
  seq: 19
}

get {
  url: {{oneRosterUrl}}/{{assessmentPath}}/assessmentEnrollments?limit=15&offset=30
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ar-lea-token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("10 assessmentEnrollments", function() {
    expect(res.getBody().assessmentEnrollments).to.have.lengthOf(10);
  });
}

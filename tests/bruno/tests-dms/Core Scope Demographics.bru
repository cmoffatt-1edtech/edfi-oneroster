meta {
  name: Core Scope Demographics
  type: http
  seq: 15
}

get {
  url: {{oneRosterUrl}}/{{rosterPath}}/demographics
  body: none
  auth: bearer
}

auth:bearer {
  token: {{dms-core-token}}
}
tests {
  test("status is 403", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("imsx failure envelope", function() {
    expect(res.getBody().imsx_codeMajor).to.equal("failure");
    expect(res.getBody().imsx_description).to.contain("roster-demographics.readonly");
  });
}

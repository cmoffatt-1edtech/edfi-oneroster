meta {
  name: No Token
  type: http
  seq: 10
}

get {
  url: {{oneRosterUrl}}/{{rosterPath}}/orgs
  body: none
  auth: none
}

tests {
  test("status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("imsx failure envelope", function() {
    expect(res.getBody().imsx_codeMajor).to.equal("failure");
    expect(res.getBody().imsx_description).to.contain("Missing or invalid Authorization header");
  });
}

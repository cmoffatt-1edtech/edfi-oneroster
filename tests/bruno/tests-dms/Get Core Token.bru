meta {
  name: Get Core Token
  type: http
  seq: 3
}

post {
  url: {{oauthUrl}}
  body: json
  auth: none
}

body:json {
  {
    "grant_type": "client_credentials",
    "client_id": "{{coreClientId}}",
    "client_secret": "{{coreClientSecret}}",
    "scope": "{{coreScope}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('dms-core-token', res.getBody().access_token);
  }
}

tests {
  test("token issued", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
